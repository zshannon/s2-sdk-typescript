{
	"$schema": "https://json.schemastore.org/tsconfig",
	"compilerOptions": {
		"rootDir": "..",
		"baseUrl": "..",
		"module": "NodeNext",
		"target": "ES2022",
		"moduleResolution": "node16",
		"lib": ["ESNext", "DOM"],
		"types": ["bun-types"],
		"esModuleInterop": true,
		"strict": true,
		"skipLibCheck": true,
		"paths": {
			"@zshannon/streamstore": ["packages/streamstore/src/index.ts"],
			"@zshannon/streamstore/*": ["packages/streamstore/src/*"],
			"@zshannon/streamstore-patterns": ["packages/patterns/src/index.ts"],
			"@zshannon/streamstore-patterns/*": ["packages/patterns/src/*"],
			"@zshannon/resumable-stream": ["packages/resumable-stream/src/index.ts"],
			"@zshannon/resumable-stream/aisdk": [
				"packages/resumable-stream/src/aisdk/index.ts"
			],
			"@zshannon/resumable-stream/tanstack-ai": [
				"packages/resumable-stream/src/tanstack-ai/index.ts"
			],
			"@zshannon/resumable-stream/tanstack-ai/client": [
				"packages/resumable-stream/src/tanstack-ai/client.ts"
			],
			"@zshannon/resumable-stream/anthropic": [
				"packages/resumable-stream/src/anthropic/index.ts"
			],
			"@zshannon/resumable-stream/anthropic/client": [
				"packages/resumable-stream/src/anthropic/client.ts"
			]
		}
	},
	"include": ["./**/*.ts"],
	"exclude": ["./local/**", "./tanstack-ai-chat/**"]
}
