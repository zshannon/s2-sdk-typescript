{
  "name": "@zshannon/streamstore-patterns",
  "version": "2.1.6",
  "description": "Add-on patterns built on top of the S2 StreamStore TypeScript SDK.",
  "license": "MIT",
  "type": "module",
  "homepage": "https://s2.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zshannon/s2-sdk-typescript.git",
    "directory": "packages/patterns"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc --noEmit",
    "format": "biome format --write",
    "lint": "biome check",
    "test": "vitest --run",
    "prepublishOnly": "node ../../scripts/check-release.mjs"
  },
  "sideEffects": false,
  "peerDependencies": {
    "@zshannon/streamstore": ">=0.21.0"
  },
  "devDependencies": {
    "@ai-sdk/openai": "^2.0.68",
    "@msgpack/msgpack": "^3.1.2",
    "ai": "^5.0.95",
    "debug": "^4.4.3",
    "tsx": "^4.19.2"
  },
  "dependencies": {
    "nanoid": "^3.3.11"
  }
}
