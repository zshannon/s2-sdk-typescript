{
  "name": "@s2-dev/streamstore",
  "version": "0.28.0",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/s2-streamstore/s2-sdk-typescript.git",
    "directory": "packages/streamstore"
  },
  "homepage": "https://s2.dev",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && bun ../../scripts/generate-version.ts && tsc --project tsconfig.build.esm.json && tsc --project tsconfig.build.cjs.json && bun ../../scripts/postbuild.ts && NPM_CONFIG_CACHE=\"${TMPDIR:-/tmp}/s2-sdk-typescript-npm-cache\" attw --pack",
    "test": "vitest --run",
    "check": "tsc --noEmit",
    "gen:version": "bun ../../scripts/generate-version.ts",
    "example:browser": "bun examples/browser/serve.ts"
  },
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./pki": {
      "import": {
        "types": "./dist/esm/pki/index.d.ts",
        "default": "./dist/esm/pki/index.js"
      },
      "require": {
        "types": "./dist/cjs/pki/index.d.ts",
        "default": "./dist/cjs/pki/index.js"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@flickfyi/biscuit": "link:@flickfyi/biscuit",
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "@protobuf-ts/runtime": "^2.11.1",
    "@scure/base": "2.4.0",
    "debug": "^4.4.3"
  },
  "typesVersions": {
    "*": {
      "pki": [
        "./dist/cjs/pki/index.d.ts"
      ]
    }
  }
}
